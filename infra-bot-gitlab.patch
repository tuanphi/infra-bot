+
+
+class FakeTelegramRequest(BaseRequest):
+    """Capture Bot API calls in memory; never connects to Telegram."""
+    def __init__(self):
+        self.calls = []
+        self.messages = []
+        self.next_id = 100
+
+    async def initialize(self):
+        pass
+
+    async def shutdown(self):
+        pass
+
+    async def do_request(self, url, method, request_data=None, **kwargs):
+        endpoint = url.rsplit("/", 1)[1]
+        parameters = request_data.parameters if request_data else {}
+        self.calls.append((endpoint, parameters))
+        if endpoint == "getMe":
+            result = BOT_USER
+        elif endpoint in ("sendMessage", "editMessageText", "editMessageReplyMarkup"):
+            self.next_id += 1
+            result = {"message_id": parameters.get("message_id", self.next_id), "date": 1,
+                      "chat": CHAT, "from": BOT_USER, "text": parameters.get("text", "")}
+            if endpoint == "sendMessage":
+                self.messages.append((result, parameters))
+        elif endpoint == "answerCallbackQuery":
+            result = True
+        else:
+            raise AssertionError("Unexpected Telegram endpoint: " + endpoint)
+        return 200, json.dumps({"ok": True, "result": result}).encode("utf-8")
+
