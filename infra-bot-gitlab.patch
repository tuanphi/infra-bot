+    async def test_two_requests_share_a_lock_and_second_run_is_refused(self):
+        await self.confirmation_menu(operator=42)
+        first_yes = self.button("Yes")
+        await self.confirmation_menu(user="second_user", operator=43)
+        second_yes = self.button("Yes")
+        entered = asyncio.Event()
+        release = asyncio.Event()
+        from gitlab_access import GitLabAccessWorkflow
+        original = GitLabAccessWorkflow.run_playbook
+
+        def slow_playbook(workflow, change):
+            loop.call_soon_threadsafe(entered.set)
+            pending = asyncio.run_coroutine_threadsafe(release.wait(), loop)
+            pending.result(timeout=5)
+            return original(workflow, change)
+
+        loop = asyncio.get_running_loop()
+        with patch.object(GitLabAccessWorkflow, "run_playbook", slow_playbook):
+            await self.click(first_yes, user_id=42)
+            await asyncio.wait_for(entered.wait(), timeout=5)
+            await self.click(second_yes, user_id=43)
+            await asyncio.sleep(0)
+            release.set()
+            await self.drain()
+        self.assertTrue(any("Đang có một lượt Ansible chạy" in text for text in self.texts()))
+        self.assertNotIn("second_user", self.fixture.path.read_text())
